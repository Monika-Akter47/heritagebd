# URL of the PHP backend API (see /backend). No trailing slash.
# Local dev default matches: php -S localhost:8080 index.php   (run from backend/)
VITE_API_URL=http://localhost:8080
# Production API (Render): https://heritagebd-api.onrender.com
# On Vercel leave VITE_API_URL unset: vercel.json forwards /api/* to that address.
# To run the local frontend against the live API instead:
# VITE_API_URL=https://heritagebd-api.onrender.com
