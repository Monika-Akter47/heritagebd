# HeritageBD: React + Vite frontend (Vercel), PHP API (Render), PostgreSQL (Supabase)

# --- Frontend (Node, Vite) ---
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# Generated before each build from heritagebd-data/uploads (scripts/build-image-manifest.mjs)
public/uploads/

# --- Backend (PHP) ---
vendor/
php_errors.log

# Private verification documents never leave the server; product and profile
# images ship with the project because the database points at them.
heritagebd-data/uploads/private/

# Local database dumps
*.sql.bak
data.mysql.sql

# --- Environment and secrets (keep .env.example) ---
.env
.env.*
!.env.example
*.local

# --- Tests ---
coverage/
.phpunit.cache/
test-results/
playwright-report/
# Generated reports (Word and PDF) stay local
docs/**/*.docx
docs/**/*.pdf

# --- Deploy tooling ---
# Vercel CLI link (holds the local project/org IDs)
.vercel/

# --- AI assistant and editor-tool files ---
.claude/
CLAUDE.md
AGENTS.md
.mcp.json
.figma/

# --- Editors and OS ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/
