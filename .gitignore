# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.tsbuildinfo
coverage/

# Environment and secrets (keep the committed .env.example)
.env
.env.*
!.env.example
*.local

# Uploads: product/profile images ship with the project (the database points at
# them); private verification documents never leave the server.
heritagebd-data/uploads/private/

# Logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*
php_errors.log

# Vercel CLI link (created by `vercel link`; holds the local project/org IDs)
.vercel/

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local Claude Code settings
.claude/settings.local.json

# Generated before each build from heritagebd-data/uploads (scripts/build-image-manifest.mjs)
public/uploads/
